# Create location object
site_location = location.Location(lat, lon, tz=tz, name = 'Gulf of Mexico')

# get solar position data


# Weather Data Info
api_key = 'unURaXbAGeMjP8359wy5gyQfWIKq1g1y7hdhUmNo'
email = 'bepstein8@gatech.edu'
keys = ['ghi', 'dni', 'dhi', 'temp_air', 'wind_speed', 'wind_direction',
        'albedo']
psm3, psm3_metadata = pvlib.iotools.get_psm3(lat, lon, api_key,
                                        email, interval=60, names='tmy',
                                        map_variables=True, leap_day=True,
                                        attributes=keys)
power_kWh = []

for j in range(1,12) :
    year = 2021
    month = j
    day = 1
    total_energy = 0
    for i in range(0,27) :

        # get times of interest

        start = "{0}-{1}-{2}".format(year,month,day)
        day = day + 1
        end = "{0}-{1}-{2}".format(year,month,day)

        times = pd.date_range(start, end, freq='60min', tz=tz) # Get times for entire study period
        wthr = psm3.iloc[0:len(times)]

        # get clearsky weather
        cs = site_location.get_clearsky(times) # Get clearsky weather data

        # get solar position data
        solar_position = site_location.get_solarposition(times)

        # set ground coverage ratio and max_angle to
        # pull orientation data for a single-axis tracker
        gcr = 0.01
        max_phi = 0
        orientation = tracking.singleaxis(solar_position['apparent_zenith'],
                                        solar_position['azimuth'],
                                        max_angle=max_phi,
                                        backtrack=True,
                                        gcr=gcr
                                        )

        # set axis_azimuth, albedo, pvrow width and height, and use
        # the pvfactors engine for both front and rear-side absorbed irradiance
        pvrow_height = 1
        pvrow_width = 1
        albedo = 0.06

        # Set windspeed and azimuth randomly
        axis_azimuth = wthr['wind_direction']
        wind_speed = wthr['wind_speed']

        # explicity simulate on pvarray with sensor placed in middle row
        # users may select different values depending on needs
        irrad_cs = pvfactors_timeseries(solar_position['azimuth'],
                                    solar_position['apparent_zenith'],
                                    orientation['surface_azimuth'],
                                    orientation['surface_tilt'],
                                    axis_azimuth,
                                    wthr.index,
                                    wthr['dni'],
                                    wthr['dhi'],
                                    gcr,
                                    pvrow_height,
                                    pvrow_width,
                                    albedo,
                                    n_pvrows=1,
                                    index_observed_pvrow=0
                                    )
    
        # turn into pandas DataFrame
        irrad_cs = pd.concat(irrad_cs, axis=1)
        # Constant air temperature
        temp_air = wthr['temp_air']
        effective_irrad_mono = irrad_cs['total_abs_front']
        temp_cell = temperature.faiman(effective_irrad_mono, temp_air=temp_air,
                                    wind_speed=wind_speed) 
        pdc0 = 80 # Nominal Power Rating
        gamma_pdc = -0.0043 # Temperature dependence coefficient

        # Create pvsystem using pvwatts model for single face solar cell
        pdc = pvsystem.pvwatts_dc(effective_irrad_mono,
                                    temp_cell,
                                    pdc0,
                                    gamma_pdc=gamma_pdc
                                    ).fillna(0)
        # Plot Results
        # series_label = "WS={val0:.1f} m/s, AZ = {val1:.1f}"
        # pdc.plot(label=series_label.format(val0 = wind_speed[0],val1 = axis_azimuth[0]))
        total_energy += np.trapz(pdc,dx=60*60)/3600000
    power_kWh.append(total_energy)

total_energy = np.sum(power_kWh)

fig = plt.figure()
plt.bar(range(1,12),power_kWh)
title = "80W Panel - Energy Collected: {val:.3f}kWh"
plt.title(title.format(val = total_energy))
plt.ylabel('Energy [kWh]')
plt.xlabel('Month')
plt.show()

