class Seaplane:
    def __init__(self, lat, lon, tz, pdc0,gamma,tracking:bool,cs:bool):
        
        # Define solar parameters
        self.lat = lat
        self.lon = lon
        self.tz = tz
        self.tracking = tracking
        self.location = location.Location(lat, lon, tz=tz, name = 'Gulf of Mexico')
        self.pdc0 = pdc0
        self.gamma = gamma
        self.collected_energy = 0 #kWh
        self.cs = cs

        # Define airframe and motion parameters
        self.installed_power_w
        self.cd0
        self.n_tot
        self.U_max
        self.S
        self.weight
        self.voltage
        self.capacity
        self.Rt
        self.n
        self.k


        print("Plane Initialized")

    def get_endurance(self,U,rho):
        E = self.Rt**(1-self.n)*(self.n_tot*self.voltage*self.capacity)/(0.5*rho*U**3*self.S*self.cd0 + (2*self.weight**2*self.k)/rho*U*self.S)

    def get_dynamic_pressure(self,rho,u):
        return 0.5*rho*u
    
    def get_power(self,U,rho):
        q = self.get_dynamic_pressure(self,U)
        D = q*self.S*self.cdtot
        return D*U # U in m/s
        # return .5*rho*U*self.S*self.cd0 + 2*self.weight**2*self.k/(rho*U*self.S)
    
    def get_times(self,year,month,day,tz):
        # get times of interest
        start = "{0}-{1}-{2}".format(year,month,day)
        day = day + 1
        end = "{0}-{1}-{2}".format(year,month,day)
        return pd.date_range(start, end, freq='60min', tz=tz) # Get times for entire study period      

    def get_weather(self,cs:bool,times):
        if cs:
            # get clearsky weather
            wthr = self.location.get_clearsky(times) # Get clearsky weather data
            print("Retrieved CS Weather Data")
        else:
            wthr = self.get_tmy()
            print("Retrieved TMY Weather Data")
        return wthr

